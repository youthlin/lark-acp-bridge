{
  "bots": [
    {
      "id": "default",
      "app_id": "",
      "app_secret": {
        "source": "file",
        "path": "$HOME/.lark-acp-bridge/secrets/default.appsecret"
      },
      "workspace": "$HOME/.lark-acp-bridge/bots/default",
      "bot_open_id": "",
      "owner_open_ids": [],
      "drive_comment": {
        "enabled": false,
        "trace_enabled": false,
        "trace_chat_id": ""
      },
      "wiki_trace": {
        "enabled": false,
        "chat_id": ""
      }
    }
  ],
  "message_reaction": false,
  "agent_list": [
    {
      "name": "traex",
      "command": "traex",
      "args": ["acp", "serve", "-c", "permission_mode=auto"],
      "env": {},
      "default_cwd": "$HOME"
    }
  ]
}
